{
  // Cloudflare Workers: static site from ./public (built by `python3 build.py`, committed to the repo)
  "name": "ecomadsfix",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Serve only on the real domain, no duplicate copy on *.workers.dev
  "routes": [
    { "pattern": "ecomadsfix.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
